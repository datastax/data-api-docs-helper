# =============================================================================
# Required Configuration
# =============================================================================
# Loaded only for `dh docs ...` commands.

# Client driver(s) to verify (comma-separated, e.g., 'java,typescript,python,bash')
# CLIENT_DRIVERS=

# Astra token for authentication
# ASTRA_TOKEN=

# Test database API endpoint
# API_ENDPOINT=

# =============================================================================
# Optional Configuration
# =============================================================================

# Path to the folder containing example projects
# EXAMPLES_FOLDER=./resources/mock_examples

# Path to the folder containing snapshots
# SNAPSHOTS_FOLDER=./snapshots

# Test reporter type ('only_failures' or 'all_tests')
# TEST_REPORTER=all_tests

# Verification mode ('normal', 'verify_only', or 'dry_run')
# VERIFY_MODE=normal

# Whether to clean the execution environment after running tests
# CLEAN=false

# Whether to stop after the first test failure
# BAIL=false

# Comma-separated regex filters to select specific tests to run
# FILTERS=

# Comma-separated regex filters to select specific tests to exclude
# INVERSE_FILTERS=

# =============================================================================
# Client Artifact Overrides
# =============================================================================
# Override the default client library version for a specific language
# Format: <LANGUAGE>_ARTIFACT=<artifact-specifier>
#
# Available languages: JAVA, PYTHON, TYPESCRIPT
#
# Examples:
#   TYPESCRIPT_ARTIFACT=@datastax/astra-db-ts@v2.0.0
#   PYTHON_ARTIFACT=/path/to/local/package
#   JAVA_ARTIFACT=com.datastax.astra:astra-db-java:2.1.0
